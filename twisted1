.card.sel{border-color:var(--acc)}
#fb{position:fixed;right:98px;bottom:calc(20px + env(safe-area-inset-bottom,0px));width:72px;height:72px;border-radius:50%;font-size:26px;padding:0;margin:0;background:var(--hud);color:var(--ink);border:2px solid var(--acc)}
#tabs{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;margin:6px 0 10px}.tab{font:inherit;font-size:14px;padding:6px 12px;border-radius:8px;border:2px solid transparent;background:var(--hud);color:var(--ink);cursor:pointer;margin:0}.tab.sel{border-color:var(--acc)}.card.lock{opacity:.6}.card.cur{border-color:var(--acc);background:rgba(232,196,74,.15)}.card em{color:var(--acc);font-style:normal;font-size:13px}#cash{color:var(--acc);font-size:20px}#mm{min-height:20px;margin-top:8px}
#dv{position:fixed;left:8px;bottom:calc(8px + env(safe-area-inset-bottom,0px));padding:4px 10px;font:12px sans-serif;background:var(--hud);color:var(--dim);border:1px solid var(--dim);border-radius:6px;margin:0;opacity:.7;z-index:20;cursor:pointer}#dp{position:fixed;left:8px;bottom:calc(44px + env(safe-area-inset-bottom,0px));width:220px;max-height:70%;overflow:auto;background:var(--hud);border:1px solid var(--acc);border-radius:8px;padding:8px;display:flex;flex-direction:column;gap:5px;font-size:13px;z-index:20}#dp[hidden]{display:none}#dp button{font:inherit;font-size:13px;padding:5px 8px;border-radius:6px;border:0;background:#2c3a35;color:var(--ink);cursor:pointer;margin:0;text-align:left}#dp label,#dr{color:var(--dim)}
#ms{position:fixed;inset:0;z-index:40;background:#0d1512;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:12px;box-sizing:border-box;overflow:auto}#ms[hidden]{display:none}#ms h1{margin:0;font-size:28px}#mc{width:min(720px,92vw,calc(100vh - 220px));height:auto;aspect-ratio:1;border-radius:8px;cursor:pointer;touch-action:none}#mt{margin:0;color:var(--acc);text-align:center}#mb{font:inherit;font-size:18px;padding:10px 28px;border:0;border-radius:8px;background:var(--acc);color:#222;cursor:pointer;margin:0}
#ld{position:fixed;inset:0;z-index:50;background:#0d1512;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;transition:opacity .6s;color:var(--ink)}#ld h1{font-size:44px;margin:0;letter-spacing:2px}#ld p{margin:0;color:var(--dim);min-height:20px}.fn{display:flex;flex-direction:column;align-items:center;gap:4px;margin-bottom:6px}.fn i{display:block;height:8px;border-radius:50%;background:#8a949c;animation:sw 1.1s ease-in-out infinite alternate}@keyframes sw{from{transform:translateX(-9px)}to{transform:translateX(9px)}}.lg{width:132px;height:132px;border-radius:28px;margin-bottom:6px}#lg2{width:72px;height:72px;border-radius:16px;display:block;margin:0 auto 8px}#lbw{width:220px;height:6px;background:#26332e;border-radius:3px;overflow:hidden}#lb{height:100%;width:0;background:var(--acc)}@media (prefers-reduced-motion:reduce){.fn i{animation:none}}
button:focus-visible{outline:3px solid var(--ink);outline-offset:2px}
#go{font:inherit;font-size:18px;padding:10px 28px;border:0;border-radius:8px;background:var(--acc);color:#222;cursor:pointer;margin-top:16px}
#c{position:fixed;left:0;top:0}
</style>
</head>
