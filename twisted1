<title>Twisted</title>
<style>
:root{--bg:#1c2a26;--ink:#eef3ee;--dim:#9fb3aa;--hud:rgba(10,18,16,.78);--acc:#e8c44a;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
