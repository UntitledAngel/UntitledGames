<canvas id="c"></canvas>
<div id="ld"><img id="lg" class="lg" src="data:image/jpeg;base64," alt="Twisted logo"><h1>Twisted</h1><div id="lbw"><div id="lb"></div></div><p id="lt">Reading radar…</p></div>
