VEH.forEach(v=>{v.cat=CATS[v.n]!==undefined?CATS[v.n]:3;v.$=v.n=="Old hatchback"?0:Math.round((150+v.m*25+v.arm*1500+(v.int?1000:0)+(v.px||0)*100+Math.max(0,v.spd-200)*2)/10)*10});
