html,body{height:100%;margin:0;background:var(--bg);color:var(--ink);font-family:"Trebuchet MS",Verdana,sans-serif;overflow:hidden;touch-action:none}
canvas{display:block;width:100%;height:100%}
#hud{position:fixed;left:8px;right:8px;top:calc(8px + env(safe-area-inset-top,0px));display:flex;gap:6px;justify-content:space-between;pointer-events:none;font-size:14px;flex-wrap:wrap}
#hud div{background:var(--hud);padding:6px 10px;border-radius:8px}
